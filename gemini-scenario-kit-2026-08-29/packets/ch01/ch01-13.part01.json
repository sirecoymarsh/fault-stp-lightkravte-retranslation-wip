      "target_ko": ""
    },
    {
      "uid": "ch01-13:56:e4907a79",
      "source_hash": "e4907a79",
      "sequence": 22,
      "source_line": 56,
      "speaker_id": "",
      "speaker_name": "서술/미지정",
      "voice_id": "",
      "ja": "『時』という濾過器を通しても残り続ける文化こそが<br>確固たる『ルゼンハイド』の性質であり<br>今を生きる僕たちの基盤を作っている",
      "required_tokens": [
        "<br>",
        "<br>"
      ],
      "target_ko": ""
    },
    {
      "uid": "ch01-13:57:28cadae7",

      "target_ko": ""
    },
    {
      "uid": "ch01-10:156:54d235c9",
      "source_hash": "54d235c9",
      "sequence": 58,
      "source_line": 156,
      "speaker_id": "kaj",
      "speaker_name": "카지",
      "voice_id": "",
      "ja": "そういえば クラウさんも<br>僕のこと『果樹園の倅』って言っていたっけ…",

    },
    {
      "uid": "ch01-10:166:da7001a",
      "source_hash": "da7001a",
      "sequence": 65,
      "source_line": 166,
      "speaker_id": "oug",
      "speaker_name": "오그즈",
      "voice_id": "",
      "ja": "当時のあいつの配給クレジットじゃ<br>オバーグの果物は月一程度しか配給できなくてな",
      "required_tokens": [

      ],
      "target_ko": ""
    },
    {
      "uid": "ch01-10:171:c81f7b98",
      "source_hash": "c81f7b98",
      "sequence": 68,
      "source_line": 171,
      "speaker_id": "oug",
      "speaker_name": "오그즈",
      "voice_id": "",
      "ja": "ああ 生まれてたぞ まだ物心つく前の話だがな",

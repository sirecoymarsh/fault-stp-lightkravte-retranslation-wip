    },
    {
      "uid": "ch01-10:159:37ce5185",
      "source_hash": "37ce5185",
      "sequence": 60,
      "source_line": 159,
      "speaker_id": "oug",
      "speaker_name": "오그즈",
      "voice_id": "",
      "ja": "そうね あいつ 王室画家になる前はうちの果樹園近くで<br>アトリエ開いてたんだよ",

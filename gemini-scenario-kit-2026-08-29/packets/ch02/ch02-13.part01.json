      "target_ko": ""
    },
    {
      "uid": "ch02-13:80:b9f19444",
      "source_hash": "b9f19444",
      "sequence": 44,
      "source_line": 80,
      "speaker_id": "",
      "speaker_name": "서술/미지정",
      "voice_id": "",
      "ja": "『理想の女性』は",

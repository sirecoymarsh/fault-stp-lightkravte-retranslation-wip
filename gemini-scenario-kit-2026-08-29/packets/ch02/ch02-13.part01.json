      "target_ko": ""
    },
    {
      "uid": "ch02-13:33:65bac24",
      "source_hash": "65bac24",
      "sequence": 14,
      "source_line": 33,
      "speaker_id": "",
      "speaker_name": "서술/미지정",
      "voice_id": "",

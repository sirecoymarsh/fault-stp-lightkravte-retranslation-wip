      "target_ko": ""
    },
    {
      "uid": "ch02-13:82:9a20525a",
      "source_hash": "9a20525a",
      "sequence": 46,
      "source_line": 82,
      "speaker_id": "",
      "speaker_name": "서술/미지정",
      "voice_id": "",
      "ja": "それを汚された気がしてならない<br>現実というこの世界に",

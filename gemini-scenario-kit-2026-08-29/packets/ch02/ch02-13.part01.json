      "sequence": 47,
      "source_line": 83,
      "speaker_id": "",
      "speaker_name": "서술/미지정",
      "voice_id": "",
      "ja": "変人 野蛮人 狂人―――<br>僕がオフィアンに抱くイメージとはそういったものだ",

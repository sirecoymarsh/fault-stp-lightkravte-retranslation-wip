      ],
      "target_ko": ""
    },
    {
      "uid": "ch02-13:79:1a048ed5",
      "source_hash": "1a048ed5",
      "sequence": 43,
      "source_line": 79,
      "speaker_id": "",
      "speaker_name": "서술/미지정",
      "voice_id": "",
      "ja": "きっと僕はどこかで思っているんだ",

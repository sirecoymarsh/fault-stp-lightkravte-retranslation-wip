      "context_before": [
        {
          "line_index": 279,
          "speaker_id": "",
          "ja": "ルゼンハイドの王族近衛騎士―――<br>ロイヤルガーディアンを代々務める<br><tip=\"battlekravte\">バトルクラフター</tip>の末裔"
